<?xml version="1.0" encoding="ISO-8859-1"?>
<system xmlns="http://www.eiffel.com/developers/xml/configuration-1-23-0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.eiffel.com/developers/xml/configuration-1-23-0 http://www.eiffel.com/developers/xml/configuration-1-23-0.xsd" name="simple_process" uuid="B8F2C3A1-7D4E-4F9B-A5C6-8E1D2F3A4B5C" library_target="simple_process">
	<description>Simple Process Library - SCOOP-compatible process execution using Win32 API</description>
	<target name="simple_process">
		<root all_classes="true"/>
		<file_rule>
			<exclude>/EIFGENs$</exclude>
			<exclude>/\..*$</exclude>
		</file_rule>
		<option warning="warning">
			<assertions precondition="true" postcondition="true" check="true" invariant="true" loop="true" supplier_precondition="true"/>
		</option>
		<setting name="console_application" value="true"/>
		<setting name="dead_code_removal" value="feature"/>
		<capability>
			<concurrency support="scoop" use="thread"/>
			<void_safety support="all"/>
		</capability>
		<external_include location="$(SIMPLE_EIFFEL)/simple_process/Clib"/>
		<library name="base" location="$ISE_LIBRARY\library\base\base.ecf"/>
		<library name="simple_datetime" location="$SIMPLE_EIFFEL/simple_datetime/simple_datetime.ecf"/>
		<library name="simple_mml" location="$SIMPLE_EIFFEL/simple_mml/simple_mml.ecf"/>
		<cluster name="src" location=".\src\" recursive="true"/>
	</target>
	<target name="simple_process_tests" extends="simple_process">
		<root class="TEST_APP" feature="make"/>
		<option warning="warning">
			<assertions precondition="true" postcondition="true" check="true" invariant="true" loop="true" supplier_precondition="true"/>
		</option>
		<setting name="console_application" value="true"/>
		<library name="simple_testing" location="$SIMPLE_EIFFEL/simple_testing/simple_testing.ecf"/>
		<library name="testing" location="$ISE_LIBRARY\library\testing\testing.ecf"/>
		<cluster name="tests" location=".\testing\" recursive="true">
			<file_rule>
				<exclude>/scoop$</exclude>
				<exclude>/echo$</exclude>
			</file_rule>
		</cluster>
	</target>
	<!-- The freeze assault (1.0.1). Every external in this library that waits on a
	     child process is a WAIT, and an unmarked wait stops ISE's collector - and with
	     it every other processor - for as long as it lasts. Proving that needs a second
	     processor allocating while the first is inside the library, so this target is
	     SCOOP where the others are threads. The child is a real one; the only unmarked
	     wait in the assault is the one BLOCKING_PROBE makes on purpose. -->
	<target name="simple_process_scoop_tests" extends="simple_process">
		<root class="SCOOP_TEST_APP" feature="make"/>
		<option warning="warning">
			<assertions precondition="true" postcondition="true" check="true" invariant="true" loop="true" supplier_precondition="true"/>
		</option>
		<setting name="console_application" value="true"/>
		<capability>
			<concurrency use="scoop"/>
		</capability>
		<cluster name="scoop_tests" location=".\testing\scoop\" recursive="true"/>
	</target>
	<!-- The child the stdin and UTF-8 tests run (1.1.0): sp_echo_child.exe copies
	     its stdin to its stdout byte for byte, plus a few modes for exit codes,
	     stderr, delay and flooding. Build it before running simple_process_tests;
	     those tests look for EIFGENs/simple_process_echo/F_code/sp_echo_child.exe. -->
	<target name="simple_process_echo" extends="simple_process">
		<root class="SP_ECHO_CHILD" feature="make"/>
		<option warning="warning">
			<assertions precondition="true" postcondition="true" check="true" invariant="true" loop="true" supplier_precondition="true"/>
		</option>
		<setting name="console_application" value="true"/>
		<setting name="executable_name" value="sp_echo_child"/>
		<cluster name="echo_child" location=".\testing\echo\" recursive="true"/>
	</target>
</system>